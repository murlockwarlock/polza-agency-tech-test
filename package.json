{
  "name": "polza-agency-tech-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "sh scripts/dcompose.sh up -d --wait db",
    "db:down": "sh scripts/dcompose.sh down",
    "db:schema": "tsx scripts/apply-schema.ts",
    "import:pages": "tsx scripts/import.ts pages",
    "import:review": "tsx scripts/import.ts review",
    "import:all": "tsx scripts/import.ts all",
    "db:verify": "tsx scripts/verify-database.ts",
    "setup": "npm run db:up && npm run db:schema && npm run import:all && npm run db:verify"
  },
  "dependencies": {
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
